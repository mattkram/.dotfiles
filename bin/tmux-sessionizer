#!/usr/bin/env zsh

if [[ $# -eq 1 ]]; then
    selected=$1
else
    selected=$(find ~/dev ~/poc -mindepth 1 -maxdepth 1 -type d | fzf)
fi

if [[ -z $selected ]]; then
    exit 0
fi

selected_name=$(basename "$selected" | tr . _)
tmux_running=$(pgrep tmux)

# Specify a config file path we will search
tmux_config="$selected/.tmux.conf"

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    # Start new tmux session in detached mode with first window named 'nvim'
    tmux new-session -d -s $selected_name -c $selected -n 'nvim' 'nvim .; exec zsh'

    # Source the local config if it exists
    if [[ -f $tmux_config ]]; then
        tmux source-file $tmux_config
    fi

    # Set up default layout: nvim, claude, zsh
    tmux new-window -t $selected_name -c $selected -n 'claude' 'claude; exec zsh'
    tmux new-window -t $selected_name -c $selected -n 'zsh'
    tmux select-window -t $selected_name:nvim

    # Attach to the session
    tmux attach-session -t $selected_name
    exit 0
fi

if ! tmux has-session -t=$selected_name 2> /dev/null; then
    # Create new session in detached mode with first window named 'nvim'
    tmux new-session -d -s $selected_name -c $selected -n 'nvim' 'nvim .; exec zsh'

    # Source the local config if it exists
    if [[ -f $tmux_config ]]; then
        tmux source-file $tmux_config
    fi

    # Set up default layout: nvim, claude, zsh
    tmux new-window -t $selected_name -c $selected -n 'claude' 'claude; exec zsh'
    tmux new-window -t $selected_name -c $selected -n 'zsh'
    tmux select-window -t $selected_name:nvim
fi

# tmux switch-client -t $selected_name
if [[ -z $TMUX ]]; then
    tmux attach-session -t $selected_name
else
    tmux switch-client -t $selected_name
fi
